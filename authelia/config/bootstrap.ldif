# Authelia user store bootstrap — gitops user management (no admin UI).
# ---
# TEMPLATE — the {REPLACE_ME} userPassword placeholders below are deployment
# secrets and are NEVER filled in this committed file. ./render-ldif.sh fills
# them from .env.secret (slappasswd {SSHA} hashes of LDAP_ADMIN_PASSWORD and
# AUTHHELIA_LOGIN_PASSWORD) into the gitignored config/bootstrap.rendered.ldif.
# Apply the RENDERED file (and re-runnable with `ldapadd -c` for new entries;
# existing entries are skipped with an "already exists" error). Run from the
# authelia directory: the LDIF is piped from the host checkout, because the
# openldap container has NO ./config mount (only the authelia service binds
# config/) — `-f /config/...` inside it is "No such file":
#
#   ./render-ldif.sh
#   podman exec -i authelia_openldap_1 ldapadd -x \
#     -D "cn=admin,dc=sseifried,dc=link" -W < config/bootstrap.rendered.ldif
#
# (-W prompts for the LDAP admin password = Bitwarden item
# authelia-ldap-admin-password.)
#
# Why {SSHA} (render-ldif.sh does this for you):
#   - cn=admin entry: osixia/openldap 1.5.0 does NOT create the cn=admin
#     entry — it only sets olcRootDN/olcRootPW in cn=config — so the entry
#     must be added here or every simple bind as cn=admin fails with
#     "Invalid credentials (49)".
#   - uid entries: Authelia authenticates by binding as the user, so SLAPD
#     verifies the scheme: osixia 1.5.0 ships OpenLDAP 2.4.57, which cannot
#     verify argon2 — a bare $argon2id$ digest is treated as plaintext and
#     login fails with "password is wrong". {SSHA} is verified natively.
#
# The placeholders are scheme-prefixed ({REPLACE_ME}) on purpose: slapd parses
# the {scheme} prefix of userPassword and rejects the unknown scheme, so
# applying the TEMPLATE by accident fails the add (fail-closed) instead of
# storing the publicly committed literal as a plaintext login password.
#
# groupOfNames requires at least one member, so the admin is also a member of
# homebase-users. Add the partner (Phase 2) as a new inetOrgPerson entry, then
# re-run the ldapadd ritual — that creates the user, but membership lives in
# the GROUP entry: ldapadd only issues ADD ops, so the existing group add is
# skipped by -c and the new member: line is silently NOT applied. Grant the
# membership with ldapmodify (changetype: modify / add: member on the group
# DN) — see docs/services.md, "User management (LDIF ritual)".
#
# Drift: users/groups live in the openldap-data volume (covered by
# backup-authelia.sh); this file is the source of truth — change users by
# editing this file, committing, and re-running ldapadd (AdGuard drift
# pattern).

# LDAP service account (olcRootDN): osixia 1.5.0 sets olcRootPW in cn=config
# only — the entry itself must exist for simple binds (Authelia's bind DN,
# ldapadd, ldapsearch). Hash of LDAP_ADMIN_PASSWORD via slappasswd (see above).
dn: cn=admin,dc=sseifried,dc=link
changetype: add
objectClass: simpleSecurityObject
objectClass: organizationalRole
cn: admin
description: LDAP administrator (Authelia bind + LDIF ritual)
userPassword: {REPLACE_ME}

dn: ou=users,dc=sseifried,dc=link
changetype: add
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=sseifried,dc=link
changetype: add
objectClass: organizationalUnit
ou: groups

dn: uid=sseifried,ou=users,dc=sseifried,dc=link
changetype: add
objectClass: inetOrgPerson
uid: sseifried
cn: Stefan Seifried
sn: Seifried
givenName: Stefan
displayName: Stefan Seifried
mail: sseifried@sseifried.link
# {scheme} prefix -> slapd rejects the unknown scheme on add (fail-closed).
# Replace with the {SSHA} hash of the Authelia LOGIN password (slapd verifies
# it on Authelia's bind-as-user login; argon2 is NOT supported by 2.4.57).
userPassword: {REPLACE_ME}

dn: cn=homebase-admins,ou=groups,dc=sseifried,dc=link
changetype: add
objectClass: groupOfNames
cn: homebase-admins
member: uid=sseifried,ou=users,dc=sseifried,dc=link

dn: cn=homebase-users,ou=groups,dc=sseifried,dc=link
changetype: add
objectClass: groupOfNames
cn: homebase-users
member: uid=sseifried,ou=users,dc=sseifried,dc=link
