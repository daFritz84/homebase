[Unit]
Description=Export TrueNAS pool state + disk temps (JSON-RPC WS) to the node_exporter textfile collector
Documentation=file:///home/chef/src/homebase/docs/services.md
# Calls pool.query + disk.temperatures over the JSON-RPC 2.0 WebSocket API
# (READONLY key from monitoring/vm/secrets/truenas-api-key) and writes
# truenas.prom to the node_exporter textfile dir. The graphite stream carries
# neither signal. The deprecated REST API is gone in TrueNAS 26.04.

[Service]
Type=oneshot
ExecStart=%h/src/homebase/monitoring/export-truenas-stats.sh
