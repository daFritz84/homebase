# bookorbit secrets — provisioned as .env.secret (gitignored, mode 0600) by
# provision-bookorbit-secrets.sh. Do not fill this file by hand; run the script.
#
#   export BW_SESSION="$(bw unlock --raw)"
#   ./provision-bookorbit-secrets.sh
#
# The script reads each key from the password field of a Bitwarden item:
#
#   bookorbit-postgres-password   -> POSTGRES_PASSWORD
#   bookorbit-jwt-secret          -> JWT_SECRET
#   bookorbit-setup-token         -> SETUP_BOOTSTRAP_TOKEN
#
# On first run (items missing) it generates the keys and prints them — save
# them to Bitwarden under the names above.
#
# WARNING: SETUP_BOOTSTRAP_TOKEN gates the one-time setup wizard — keep it in
# Bitwarden after first use. JWT_SECRET rotation invalidates all sessions
# (everyone logged out). POSTGRES_PASSWORD changes need
# `podman-compose up -d --force-recreate` AND an ALTER USER in the running DB.
#
# Static config (APP_URL, POSTGRES_*, PUID/PGID, LIBRARY_BROWSE_ROOT, ...)
# lives in compose.yaml. The OIDC provider (client secret) is configured
# in-app (Settings > OIDC/SSO) — the RAW authelia-oidc-bookorbit-secret is
# pasted there, never stored in this file.

POSTGRES_PASSWORD=
JWT_SECRET=
SETUP_BOOTSTRAP_TOKEN=
