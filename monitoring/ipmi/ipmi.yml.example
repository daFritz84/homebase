---
# ipmi-exporter config TEMPLATE. The live file ipmi/ipmi.yml is gitignored
# (0600) and rendered by provision-monitoring-secrets.sh from the Bitwarden
# item `bmc-ipmi` (username + password fields) — it carries the BMC
# credentials, never commit it.
#
# Remote multi-target pattern: scrape
#   /ipmi?target=192.168.178.190&module=autoconf
# (see vm/promscrape.yml job `ipmi`). v1.10.1 schema: per-module
# user/pass/driver/privilege/timeout/collectors — the master-branch top-level
# `auth:` list and `collector_timeout` are "unknown fields" there (probed at
# first deploy 2026-11-15). session timeout 10s; a scrape can take up to
# timeout x #-of-collectors, the VM scrape_timeout 30s is the outer bound.
modules:
  autoconf:
    user: BMC_USERNAME
    pass: BMC_PASSWORD
    driver: "LAN_2_0"
    privilege: "admin"
    timeout: 10000
    collectors:
    - bmc
    - ipmi
    - chassis
    - sel
    # NO dcmi: the freeipmi 1.6.15 bundled in the v1.10.1 image has no
    # --get-power-reading option (probed 2026-11-19: "unrecognized option"),
    # so the collector can never succeed — it timed out on every scrape
    # since first deploy. The BMC itself answers fine (sensors/chassis/sel).
