{
  "uid": "homebase-network",
  "title": "Homebase Network",
  "tags": ["homebase", "gitops", "network"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "TrueNAS state",
      "id": 15,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "OFFLINE (intended)", "color": "orange" }, "-1": { "text": "OFFLINE (network)", "color": "red" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "homebase:truenas_state" } ]
    },
    {
      "type": "stat",
      "title": "Fritzbox WAN link",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "fritzbox_wan_physical_link_up" } ]
    },
    {
      "type": "stat",
      "title": "Fritzbox WAN uptime",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 600 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "fritzbox_wan_uptime_seconds" } ]
    },
    {
      "type": "stat",
      "title": "WAN external IP",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "name" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "fritzbox_wan_external_ip_info", "legendFormat": "{{ip}}" } ]
    },
    {
      "type": "stat",
      "title": "TrueNAS pools online",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DEGRADED", "color": "red" }, "1": { "text": "ONLINE", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "truenas_pool_status", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "stat",
      "title": "Chassis power (IPMI)",
      "id": 16,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "ON", "color": "green" }, "0": { "text": "OFF", "color": "orange" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "ipmi_chassis_power_state" } ]
    },
    {
      "type": "timeseries",
      "title": "WAN traffic (bytes/s)",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(fritzbox_wan_bytes_received_total[10m])", "legendFormat": "down" },
        { "refId": "B", "expr": "rate(fritzbox_wan_bytes_sent_total[10m])", "legendFormat": "up" }
      ]
    },
    {
      "type": "timeseries",
      "title": "TrueNAS disk temperatures",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "celsius", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 60 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "truenas_disk_temperature_celsius", "legendFormat": "{{disk}}" } ]
    },
    {
      "type": "stat",
      "title": "BMC scrape up",
      "id": 7,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "ipmi_up" } ]
    },
    {
      "type": "timeseries",
      "title": "BMC temperatures",
      "id": 8,
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "celsius", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 85 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "ipmi_temperature_celsius", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "timeseries",
      "title": "BMC fans",
      "id": 9,
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "rpm", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1000 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "ipmi_fan_speed_rpm", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "stat",
      "title": "Network probes up",
      "id": 10,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 3 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count(probe_success{instance=~\"192.168.178.(1:49000|58:443|190:623)\"} == 1)" } ]
    },
    {
      "type": "statushistory",
      "title": "TrueNAS probe (tcp :443)",
      "id": 17,
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "legend": { "displayMode": "hidden", "showLegend": false }, "alignValue": "left", "mergeValues": true, "showLastValue": true, "rowHeight": 0.9 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "probe_success{instance=\"192.168.178.58:443\"}", "legendFormat": "tcp :443" } ]
    },
    {
      "type": "timeseries",
      "title": "NAS CPU temperature",
      "id": 11,
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "celsius", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 85 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "scale_truenas_cputemp_temperatures_cpu", "legendFormat": "cpu" } ]
    },
    {
      "type": "timeseries",
      "title": "NAS load",
      "id": 12,
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "scale_truenas_system_load_load1", "legendFormat": "load1" },
        { "refId": "B", "expr": "scale_truenas_system_load_load5", "legendFormat": "load5" },
        { "refId": "C", "expr": "scale_truenas_system_load_load15", "legendFormat": "load15" }
      ]
    },
    {
      "type": "timeseries",
      "title": "ZFS ARC size",
      "id": 13,
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "scale_truenas_truenas_arcstats_size_size", "legendFormat": "arc" } ]
    },
    {
      "type": "stat",
      "title": "NAS uptime",
      "id": 14,
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "scale_truenas_system_uptime_uptime" } ]
    }
  ]
}
