{
  "uid": "homebase-overview",
  "title": "Homebase Overview",
  "tags": ["homebase", "gitops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets up",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count(up == 1)" } ]
    },
    {
      "type": "stat",
      "title": "Endpoints up",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count(probe_success == 1)" } ]
    },
    {
      "type": "gauge",
      "title": "Root filesystem used",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 85 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100" } ]
    },
    {
      "type": "stat",
      "title": "Containers up",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count(podman_container_up == 1)" } ]
    },
    {
      "type": "timeseries",
      "title": "CPU %",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)" } ]
    },
    {
      "type": "timeseries",
      "title": "Memory %",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100" } ]
    },
    {
      "type": "timeseries",
      "title": "Container memory % (of limit)",
      "id": 7,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "podman_container_mem_percent", "legendFormat": "{{name}}" } ]
    },
    {
      "type": "row",
      "title": "Backups (offsite restic -> Storage Share)",
      "id": 8,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Newest archive age",
      "id": 9,
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 604800 }, { "color": "red", "value": 691200 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "time() - max(backup_last_success_timestamp_seconds)" } ]
    },
    {
      "type": "stat",
      "title": "Weekly job status",
      "id": 10,
      "gridPos": { "h": 4, "w": 4, "x": 5, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "FAILED", "color": "red" }, "1": { "text": "OK", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "backup_last_run_success" } ]
    },
    {
      "type": "stat",
      "title": "Monthly verify age",
      "id": 11,
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 3024000 }, { "color": "red", "value": 3456000 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "time() - max(backup_verify_last_success_timestamp_seconds)" } ]
    },
    {
      "type": "stat",
      "title": "Restic repo size (budget 5 GB)",
      "id": 12,
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 3221225472 }, { "color": "red", "value": 5368709120 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "restic_repo_size_bytes" } ]
    },
    {
      "type": "stat",
      "title": "Storage Share quota used (1 TB plan)",
      "id": 13,
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 700000000000 }, { "color": "red", "value": 850000000000 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "nextcloud_quota_used_bytes" } ]
    }
  ]
}
