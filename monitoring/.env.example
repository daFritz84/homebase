# monitoring/.env.example — copy to monitoring/.env.secret (gitignored, 0600)
# and fill in, or run ./provision-monitoring-secrets.sh (Bitwarden -> .env.secret).
# Consumed by grafana + alertmanager (env_file). victoriametrics/vmalert/blackbox/
# ipmi-exporter have NO env_file (their config is files). The network-device
# scrape secrets are file-based, rendered by the same script (gitignored, 0600):
# ipmi/ipmi.yml (BMC auth, template ipmi/ipmi.yml.example) and
# vm/secrets/truenas-api-key (TrueNAS JSON-RPC API key).

# --- Grafana ---
# Break-glass admin password (the OIDC login is the primary path; this is the
# fallback if Authelia is down). Resolved from Bitwarden grafana-admin-password
# if present, else a generated value — the Bitwarden item is unprovisioned, so this
# env value is the live credential.
GF_SECURITY_ADMIN_PASSWORD=
# RAW Authelia OIDC client secret for the `grafana` client (the argon2 digest of
# the SAME value is what authelia/config/configuration.yml expects via
# GRAFANA_OIDC_CLIENT_SECRET_HASH). Bitwarden: authelia-oidc-grafana-secret.
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=

# --- Alertmanager Telegram receiver ---
# Bot token from @BotFather (the secret). Bitwarden: telegram-bot-token. The
# chat id is NOT a secret and lives as a literal in alertmanager/alertmanager.yml
# (amtool cannot validate an env-expanded int64); provision-monitoring-secrets.sh
# prints it from Bitwarden `telegram-chat-id`.
TELEGRAM_BOT_TOKEN=
