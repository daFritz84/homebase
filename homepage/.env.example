# Homepage dashboard secrets - copy to .env and fill in.
# Referenced by config/services.yaml via {{HOMEPAGE_VAR_*}}.

# Required since Homepage v1.0: host-header check for non-localhost access.
# Comma-separated (no spaces), must match the Host header exactly as served
# (here via Caddy). Missing -> 403 host-validation errors on the dashboard.
HOMEPAGE_ALLOWED_HOSTS=homepage.sseifried.link

# AdGuard Home web UI login
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=

# --- Auth gate: Authelia OIDC SSO (Homepage v2.0+ built-in, v2.7.0) ---
# HOMEPAGE_AUTH_SECRET: openssl rand -base64 32 (cookie signing).
# HOMEPAGE_OIDC_CLIENT_SECRET: RAW value of the Bitwarden item
# authelia-oidc-homepage-secret (the argon2 hash goes into
# authelia/config/configuration.yml) — provision-authelia-secrets.sh prints
# both. Authelia authorizes the `homepage` OIDC client; Homepage admits any
# identity Authelia authorizes (no claim-based authorization).
# Auto-login sends unauthenticated visitors straight to Authelia; escape
# hatch: /auth/signin?autologin=0.
HOMEPAGE_AUTH_ENABLED=true
HOMEPAGE_AUTH_SECRET=
HOMEPAGE_EXTERNAL_URL=https://homepage.sseifried.link
HOMEPAGE_OIDC_ISSUER=https://authelia.sseifried.link
HOMEPAGE_OIDC_CLIENT_ID=homepage
HOMEPAGE_OIDC_CLIENT_SECRET=
HOMEPAGE_OIDC_AUTO_LOGIN=true
