# TLS: Let's Encrypt wildcard cert (sseifried.link + *.sseifried.link) via DNS-01 / Cloudflare.
# Requires CF_API_TOKEN, ACME_EMAIL and ACME_CA (see .env.example, provision-caddy-secrets.sh).
# The dns option lives in the (tls) snippet's "tls issuer acme" block: the global "dns"
# shorthand alone does NOT wire dns_challenge into the issuer (Caddy 2.11), which falls back
# to http-01/tls-alpn-01 and fails with NXDOMAIN on this LAN-only setup.
{
	email {env.ACME_EMAIL}
	acme_ca {env.ACME_CA}
}

# Shared wildcard-cert config for all TLS sites
(tls) {
	tls {
		issuer acme {
			email {env.ACME_EMAIL}
			dir {env.ACME_CA}
			dns cloudflare {env.CF_API_TOKEN}
		}
	}
}

# Authelia forward-auth wall (Authelia 4.38+ official Caddy integration:
# /api/authz/forward-auth; the legacy /api/authelia/validate?rd= endpoint is
# gone — the redirect target is derived from the X-Forwarded-* headers Caddy
# sends, and the portal URL from session.cookies.authelia_url in Authelia's
# configuration.yml). trusted_proxies must match the caddy-proxy subnet
# (`podman network inspect caddy-proxy`) — the subnet has drifted before, see
# docs/operations.md troubleshooting.
(authelia-fa) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		trusted_proxies 10.89.0.0/24
	}
}

# HTTP: redirect everything to the HTTPS Homepage UI (wildcard cert covers *.sseifried.link).
# /health stays proxied in plaintext for container health checks and LAN monitoring
# (Homepage's public /api/healthcheck endpoint — v2.x renamed it from /api/health, which
# now 404s). Homepage validates the Host header (HOMEPAGE_ALLOWED_HOSTS), so the health
# block forwards the allowed hostname — the plain-IP request would otherwise get a 400.
# The matcher is evaluated once at handle-block entry:
# a bare `rewrite @health ...` + `reverse_proxy @health` pair breaks because the rewrite
# mutates the path before reverse_proxy re-evaluates the matcher (then it never matches).
# Temporary (302) redirect: switch to `permanent` once HSTS is proven in production.
# Clients must resolve *.sseifried.link via AdGuard Home split DNS (see docs/services.md).
:80 {
	@health path /health /health/*
	@nothealth not path /health /health/*
	handle @health {
		rewrite * /api/healthcheck
		reverse_proxy homepage:3000 {
			header_up Host homepage.sseifried.link
		}
	}
	redir @nothealth https://homepage.sseifried.link{uri}
}

# --- TLS services (resolved to this host by AdGuard Home split DNS) ---

# Homepage — no forward-auth wall: Homepage's built-in OIDC gate redirects to
# Authelia (native SSO). Authelia authorizes the `homepage` OIDC client;
# Homepage admits any identity Authelia authorizes (verified in v2.7.0 docs).
homepage.sseifried.link {
	import tls
	reverse_proxy homepage:3000
}

# Authelia portal (login + 2FA enrollment + OIDC IdP) — serves itself,
# access_control rule bypasses its own domain
authelia.sseifried.link {
	import tls
	reverse_proxy authelia:9091
}

# Wanderer (trail database) — behind the Authelia wall (one_factor for
# homebase-admins; Wanderer's own account login stays on top of it)
wanderer.sseifried.link {
	import tls
	route {
		import authelia-fa
		reverse_proxy wanderer:3000
	}
}

# AdGuard Home — behind the Authelia wall (one_factor for homebase-admins)
adguard.sseifried.link {
	import tls
	route {
		import authelia-fa
		reverse_proxy 192.168.178.249:8095
	}
}

# Home Assistant (host-networked container — AdGuard pattern: hardcoded host IP,
# rootless containers cannot reach host services by name) — behind the Authelia
# wall (one_factor for homebase-admins).
# Two bypasses of the wall, both authenticated by HA itself (Authelia 4.38+
# removed the legacy bypass_credentials/user-agent ACL criteria, so they live
# here):
#   - Companion app: sends no browser cookies, so it cannot pass the wall.
#     Requests from the Companion user-agents skip forward_auth and go straight
#     to HA, which authenticates the app with its own long-lived access token.
#     Caddy >=2.8 removed regex from the header matcher (exact + * wildcards
#     only) — the UA matcher MUST be header_regexp, a regex in `header` is
#     compared literally and never matches. If the app's user-agent string
#     changes, the pattern must follow (docs/services.md).
#   - Bearer-token API clients (automations, custom cards, external tools):
#     they send Authorization: Bearer <long-lived token> and no Authelia
#     cookie, so the wall would 302 them to the portal. HA validates its own
#     tokens, so these are proxied directly.
# Residual risk (accepted): User-Agent is client-controlled, so any client that
# can reach this listener can spoof the Companion UA and reach HA's own
# single-factor login, evading Authelia's 2FA and regulation bans
# (docs/services.md, "HA wall bypasses").
homeassistant.sseifried.link {
	import tls
	@companion header_regexp User-Agent ^(HomeAssistant/|com\.homeassistant\.companion\.android)
	@bearer header Authorization "Bearer *"
	handle @companion {
		reverse_proxy 192.168.178.249:8123
	}
	handle @bearer {
		reverse_proxy 192.168.178.249:8123
	}
	handle {
		route {
			import authelia-fa
			reverse_proxy 192.168.178.249:8123
		}
	}
}

# Cockpit (host service — hardcoded host IP, like AdGuard/HA; Caddy passes
# WebSockets through, required by Cockpit). Cockpit validates the Host header
# (only localhost/hostname/AllowOrigin hosts pass), so Caddy forwards the public
# Host; AllowOrigin in /etc/cockpit/cockpit.conf covers the browser Origin.
# Cockpit must be proxied over HTTPS: it redirects NON-LOCAL plain-HTTP requests
# to https (301 -> loop) and only trusts X-Forwarded-Proto from localhost, which
# a rootless Caddy container is not. Cockpit serves a self-signed cert on :9090,
# so the upstream is https with tls_insecure_skip_verify.
cockpit.sseifried.link {
	import tls
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy https://192.168.178.249:9090 {
		header_up Host cockpit.sseifried.link
		transport http {
			tls_insecure_skip_verify
		}
	}
}
