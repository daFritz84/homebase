# TLS: Let's Encrypt wildcard cert (sseifried.link + *.sseifried.link) via DNS-01 / Cloudflare.
# Requires CF_API_TOKEN, ACME_EMAIL and ACME_CA (see .env.example, provision-caddy-secrets.sh).
# The dns option lives in each site's "tls issuer acme" block: the global "dns" shorthand
# alone does NOT wire dns_challenge into the issuer (Caddy 2.11), which falls back to
# http-01/tls-alpn-01 and fails with NXDOMAIN on this LAN-only setup.
{
	email {env.ACME_EMAIL}
	acme_ca {env.ACME_CA}
}

# Direct-IP access and container health checks (stays HTTP)
:80, http://homebase.fritz.box {
	reverse_proxy komodo:9120
}

# --- TLS services (resolved to this host by AdGuard Home split DNS) ---

# Komodo
komodo.sseifried.link {
	tls {
		issuer acme {
			email {env.ACME_EMAIL}
			dir {env.ACME_CA}
			dns cloudflare {env.CF_API_TOKEN}
		}
	}
	reverse_proxy komodo:9120
}

# nginx-ping
testweb.sseifried.link {
	tls {
		issuer acme {
			email {env.ACME_EMAIL}
			dir {env.ACME_CA}
			dns cloudflare {env.CF_API_TOKEN}
		}
	}
	reverse_proxy testweb:80
}

# Homepage
homepage.sseifried.link {
	tls {
		issuer acme {
			email {env.ACME_EMAIL}
			dir {env.ACME_CA}
			dns cloudflare {env.CF_API_TOKEN}
		}
	}
	reverse_proxy homepage:3000
}

# AdGuard Home
adguard.sseifried.link {
	tls {
		issuer acme {
			email {env.ACME_EMAIL}
			dir {env.ACME_CA}
			dns cloudflare {env.CF_API_TOKEN}
		}
	}
	reverse_proxy 192.168.178.249:8095
}
