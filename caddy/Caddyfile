# TLS: Let's Encrypt wildcard cert (sseifried.link + *.sseifried.link) via DNS-01 / Cloudflare.
# Requires CF_API_TOKEN and ACME_EMAIL (see .env.example, provision-caddy-secrets.sh).
{
	email {env.ACME_EMAIL}
	# Pin the CA to Let's Encrypt — Caddy's defaults would also try ZeroSSL:
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	dns cloudflare {env.CF_API_TOKEN}
	# During first bring-up, swap the acme_ca URL to the staging CA to avoid production rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Direct-IP access, container health checks, and legacy LAN names (stays HTTP)
:80, http://homebase.fritz.box, http://komodo.home.arpa {
	reverse_proxy komodo:9120
}

# --- TLS services (resolved to this host by AdGuard Home split DNS) ---

# Komodo
komodo.sseifried.link {
	reverse_proxy komodo:9120
}

# nginx-ping
testweb.sseifried.link {
	reverse_proxy testweb:80
}

# Homepage
homepage.sseifried.link {
	reverse_proxy homepage:3000
}

# AdGuard Home
adguard.sseifried.link {
	reverse_proxy 192.168.178.249:8095
}

# --- transition: legacy *.home.arpa serving (remove after TLS verification) ---
http://testweb.home.arpa {
	reverse_proxy testweb:80
}

http://homepage.home.arpa {
	reverse_proxy homepage:3000
}

http://adguard.home.arpa {
	reverse_proxy 192.168.178.249:8095
}
