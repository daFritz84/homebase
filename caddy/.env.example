# Cloudflare API token: Zone / DNS / Edit, scoped to the sseifried.link zone, no IP restriction.
# Provisioned from Bitwarden by provision-caddy-secrets.sh (item: caddy-cloudflare-token).
CF_API_TOKEN=
# ACME registration email for Let's Encrypt expiry notifications.
ACME_EMAIL=
# ACME CA directory. Production (default) / staging for bring-up testing:
# https://acme-v02.api.letsencrypt.org/directory
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
