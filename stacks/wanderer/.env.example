# wanderer secrets — provisioned as .env.secret (gitignored, mode 0600) by
# provision-wanderer-secrets.sh. Do not fill this file by hand; run the script.
#
#   bw login && export BW_SESSION="$(bw unlock --raw)"
#   ./provision-wanderer-secrets.sh
#
# The script reads each key from the password field of a Bitwarden item:
#
#   wanderer-meili-key           -> MEILI_MASTER_KEY
#   wanderer-pb-encryption-key   -> POCKETBASE_ENCRYPTION_KEY
#   wanderer-pb-proxy-secret     -> POCKETBASE_PROXY_SECRET
#
# On first run (items missing) it generates the keys and prints them — save
# them to Bitwarden under the names above.
#
# WARNING: POCKETBASE_ENCRYPTION_KEY encrypts trail data at rest. Rotating it
# after data exists makes the database unreadable. Keep the Bitwarden item as
# the single source of truth; the script never overwrites an existing item.
#
# Static config (ORIGIN, PUBLIC_PRIVATE_INSTANCE, PUBLIC_DISABLE_SIGNUP, ...)
# lives in compose.yaml. PUBLIC_DISABLE_SIGNUP must be "false" for the first
# boot to create the account, then flipped back to "true".

MEILI_MASTER_KEY=
POCKETBASE_ENCRYPTION_KEY=
POCKETBASE_PROXY_SECRET=
