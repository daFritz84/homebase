# Beszel AGENT env — copy to beszel/agent.env (gitignored, mode 0600) and fill in.
# Consumed by systemd/user/beszel-agent.service (EnvironmentFile).
#
# KEY and TOKEN come from the hub UI: hub -> Add System -> the install command
# shows the public KEY and the TOKEN. Save them to Bitwarden
# (beszel-agent-key, beszel-agent-token). The agent dials the hub over the
# loopback-published port (the hub publishes 127.0.0.1:8090).

# Public key shown when adding the system in the hub.
KEY=
# WebSocket registration token from the hub.
TOKEN=
# Hub URL the agent dials (loopback-published port; see beszel/compose.yaml).
HUB_URL=http://127.0.0.1:8090
# Agent listener port (unused in WebSocket-only mode; kept for the SSH server).
LISTEN=45876
# WebSocket-only: disable the agent's SSH server (hub also sets DISABLE_SSH=true).
DISABLE_SSH=true
# Podman API socket for container stats (chef's own rootless socket — the agent
# runs as chef, so it reads it directly; no socket-proxy). podman.socket must be
# enabled (it is, for the homepage).
DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
# Kill outbound image-registry update checks (no telemetry).
DOCKER_IMAGE_CHECK=false
