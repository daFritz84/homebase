
# Secret files generated from Bitwarden
.secrets/
.secrets/*

# Environment files with secrets (e.g. homepage/.env, wanderer/.env.secret).
**/.env
**/.env.secret
!.env.example

# Home Assistant: UI-managed state + secrets stay out of git (see homeassistant)
homeassistant/config/.storage/
homeassistant/config/secrets.yaml
# HA runtime state (data/logs/version marker, not committed YAML) — covered by backup-ha-config.sh
homeassistant/config/.HA_VERSION
homeassistant/config/.cache/
homeassistant/config/.ha_run.lock
homeassistant/config/blueprints/
homeassistant/config/home-assistant.log*
homeassistant/config/home-assistant_v2.db*

# Wanderer runtime data (PocketBase pb_data, uploads, Meilisearch data.ms,
# plugins) — data, not code; covered by backup-wanderer-data.sh
wanderer/data/

# Authelia runtime data + key material (sqlite DB, OIDC signing keys, notifier
# outbox) — data, not code; covered by backup-authelia.sh
authelia/config/db/
authelia/config/keys/
authelia/config/notifier/

# Rendered LDIF (deployment {SSHA} hashes from .env.secret via render-ldif.sh)
# — secrets, never commit; the template config/bootstrap.ldif is the source
authelia/config/bootstrap.rendered.ldif

# Kilo working plans (local migration notes, not part of the stack)
.kilo/plans/
