
# Secret files generated from Bitwarden
.secrets/
.secrets/*

# Environment files with secrets (e.g. homepage/.env, wanderer/.env.secret).
**/.env
**/.env.secret
!.env.example

# Home Assistant: UI-managed state + secrets stay out of git (see homeassistant)
homeassistant/config/.storage/
homeassistant/config/secrets.yaml
# Python bytecode generated by HA loading custom_components (runtime, not code)
homeassistant/config/custom_components/**/__pycache__/
# HA runtime state (data/logs/version marker, not committed YAML) — covered by backup-ha-config.sh
homeassistant/config/.HA_VERSION
homeassistant/config/.cache/
homeassistant/config/.ha_run.lock
homeassistant/config/blueprints/
homeassistant/config/home-assistant.log*
homeassistant/config/home-assistant_v2.db*

# Wanderer runtime data (PocketBase pb_data, uploads, Meilisearch data.ms,
# plugins) — data, not code; covered by backup-wanderer-data.sh
wanderer/data/

# Navidrome runtime data (navidrome.db: users, playlists, share tokens and the
# auto-generated session/password secrets; plus rebuildable caches: scans,
# transcodes) — data, not code; covered by backup-navidrome-data.sh
navidrome/data/

# Jellyfin runtime data (jellyfin.xml incl. VAAPI settings, users, password
# hashes, API keys, plugin DB) — data, not code; covered by
# backup-jellyfin-data.sh. cache/ (transcodes, artwork) is rebuildable.
# media/ is NOT ignored: the tracked .gitkeep keeps the bind source present
# in every checkout (navidrome's music/ pattern).
jellyfin/data/
jellyfin/cache/

# Stirling PDF runtime data (data/configs: settings.yml + built-in user DB +
# nightly DB backups + generated keys; data/storage: user-saved files) —
# data, not code; covered by backup-stirling-pdf-data.sh. data/logs is
# rebuildable.
stirling-pdf/data/

# Authelia runtime data + key material (sqlite DB, OIDC signing keys, notifier
# outbox) — data, not code; covered by backup-authelia.sh
authelia/config/db/
authelia/config/keys/
authelia/config/notifier/

# Rendered LDIF (deployment {SSHA} hashes from .env.secret via render-ldif.sh)
# — secrets, never commit; the template config/bootstrap.ldif is the source
authelia/config/bootstrap.rendered.ldif

# Cloudflare Tunnel credentials JSON (Bitwarden item
# cloudflared-tunnel-credentials via provision-cloudflared-secrets.sh) —
# account-level secret, never commit; the ingress allowlist config.yml IS
# committed (the auditable exposure surface)
cloudflared/credentials.json

# Kilo working plans (local migration notes, not part of the stack)
.kilo/plans/
