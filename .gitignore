
# Secret files generated from Bitwarden
.secrets/
.secrets/*

# Environment files with secrets (e.g. stacks/homepage/.env, stacks/wanderer/.env.secret).
**/.env
**/.env.secret
!.env.example

# Home Assistant: UI-managed state + secrets stay out of git (see stacks/homeassistant)
stacks/homeassistant/config/.storage/
stacks/homeassistant/config/secrets.yaml
